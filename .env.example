# Local content mode. For production, remove this and configure PUSHPOST_REMOTE_URL.
PUSHPOST_CONTENT_ROOT=./examples/content-repository
PUSHPOST_REMOTE_URL=
PUSHPOST_BRANCH=main
PUSHPOST_REPOSITORY_ID=default
PUSHPOST_DATA_DIR=./var/dev
PUSHPOST_SITE_URL=http://127.0.0.1:3000
PUSHPOST_SITE_TITLE=PushPost
PUSHPOST_HOST=127.0.0.1
PUSHPOST_PORT=3000
PUSHPOST_RECONCILE_INTERVAL_MS=60000

# Replace all example values outside local development.
PUSHPOST_ADMIN_EMAIL=admin@example.com
PUSHPOST_ADMIN_PASSWORD=replace-with-a-long-password
PUSHPOST_SESSION_SECRET=replace-with-at-least-32-random-characters
PUSHPOST_COOKIE_SECURE=false

PUSHPOST_WEBHOOK_SECRET=
PUSHPOST_WEBHOOK_REPOSITORY=SleepySoft/content
PUSHPOST_DECAP_GITHUB_REPO=SleepySoft/content
PUSHPOST_DECAP_GITHUB_BRANCH=main
PUSHPOST_DECAP_BASE_URL=

# WordPress credentials are derived from metadata/platforms.yml credential_ref.
# For credential_ref: pushpost/wordpress-main:
PUSHPOST_PUSHPOST_WORDPRESS_MAIN_USERNAME=
PUSHPOST_PUSHPOST_WORDPRESS_MAIN_APP_PASSWORD=
# Non-secret baseUrl can instead be set in target options.
PUSHPOST_PUSHPOST_WORDPRESS_MAIN_BASE_URL=https://wordpress.example.com
